---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parseReadmeDictionary } from "../lib/readmeDictionary";
import "../styles/dictionary.css";

const markdown = readFileSync(join(process.cwd(), "README.md"), "utf8");
const dictionary = parseReadmeDictionary(markdown);
const entriesBySlug = new Map(dictionary.entries.map((entry) => [entry.slug, entry]));
const entriesBySection = new Map(
  dictionary.sections.map((section) => [
    section.id,
    dictionary.entries.filter((entry) => entry.sectionId === section.id),
  ])
);

function sectionIndex(sectionId: string): number {
  return Math.max(0, dictionary.sections.findIndex((section) => section.id === sectionId));
}

function entryLink(slug: string): string {
  return `#${slug}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{dictionary.title}</title>
  </head>
  <body>
    <header class="page-head">
      <div class="masthead">
        <h1>{dictionary.title}</h1>
        <p>
          {dictionary.stats.entryCount} concepts, {dictionary.stats.sectionCount} source
          sections, {dictionary.stats.linkCount} internal relationships. Summaries first,
          source prose collapsed.
        </p>
        <details class="source-intro">
          <summary>Source intro</summary>
          <div set:html={dictionary.introHtml} />
        </details>
      </div>

      <div class="opening-grid" aria-label="Dictionary structure">
        <section class="readout" aria-labelledby="readout-heading">
          <h2 id="readout-heading">Structure</h2>
          <dl>
            <div>
              <dt>Sections</dt>
              <dd>{dictionary.stats.sectionCount}</dd>
            </div>
            <div>
              <dt>Terms</dt>
              <dd>{dictionary.stats.entryCount}</dd>
            </div>
            <div>
              <dt>Median words</dt>
              <dd>{dictionary.stats.medianWords}</dd>
            </div>
            <div>
              <dt>Cross links</dt>
              <dd>{dictionary.stats.linkCount}</dd>
            </div>
          </dl>
        </section>

        <nav class="hub-list" aria-labelledby="hub-heading">
          <h2 id="hub-heading">High traffic terms</h2>
          <ol>
            {dictionary.linkGraph.hubs.map((hub) => (
              <li>
                <a href={entryLink(hub.slug)}>{hub.term}</a>
                <span>{hub.inboundCount}</span>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </header>

    <main>
      <section class="section-map" aria-labelledby="map-heading">
        <div class="section-map-head">
          <h2 id="map-heading">Section Map</h2>
          <p>Source order, term density, and local clusters.</p>
        </div>
        <div class="section-map-grid">
          {dictionary.sections.map((section) => (
            <a
              class="section-tile"
              href={`#${section.id}`}
              style={`--section-index:${sectionIndex(section.id)}`}
            >
              <span class="section-number">{section.number}</span>
              <span class="section-name">{section.label}</span>
              <span class="section-count">{section.entries.length} terms</span>
            </a>
          ))}
        </div>
      </section>

      <section class="concept-deck" aria-labelledby="deck-heading">
        <div class="deck-head">
          <h2 id="deck-heading">Concept Deck</h2>
          <p>Each card is a source-derived summary, relationship map, and collapsed entry.</p>
        </div>

        {dictionary.sections.map((section) => (
          <section
            id={section.id}
            class="dictionary-section"
            style={`--section-index:${sectionIndex(section.id)}`}
            aria-labelledby={`${section.id}-heading`}
          >
            <header class="dictionary-section-head">
              <span>Section {section.number}</span>
              <h2 id={`${section.id}-heading`}>{section.label}</h2>
              <p>{section.entries.length} terms</p>
            </header>

            <div class="knowledge-grid">
              {(entriesBySection.get(section.id) ?? []).map((entry) => {
                const outbound = entry.outboundLinks
                  .map((slug) => entriesBySlug.get(slug))
                  .filter(Boolean)
                  .slice(0, 5);
                const inbound = entry.inboundLinks
                  .map((slug) => entriesBySlug.get(slug))
                  .filter(Boolean)
                  .slice(0, 5);
                const related = [...outbound, ...inbound]
                  .filter(Boolean)
                  .filter(
                    (item, index, all) =>
                      item && all.findIndex((other) => other?.slug === item.slug) === index
                  )
                  .slice(0, 6);

                return (
                  <article id={entry.slug} class="knowledge-card">
                    <header class="card-top">
                      <h3>{entry.term}</h3>
                      <span class="card-section">S{section.number}</span>
                    </header>

                    <p class="one-line">{entry.oneLineText}</p>

                    <div class="signal-row" aria-label={`${entry.term} signals`}>
                      <span>{entry.wordCount} words</span>
                      <span>{entry.outboundLinks.length} out</span>
                      <span>{entry.inboundLinks.length} in</span>
                    </div>

                    {related.length > 0 && (
                      <div class="relation-block">
                        <strong>Related</strong>
                        <div class="relation-row">
                          {related.map((target) => target && (
                            <a href={entryLink(target.slug)}>{target.term}</a>
                          ))}
                        </div>
                      </div>
                    )}

                    <div class="cue-block">
                      <strong>Contains</strong>
                      <ul class="cue-list">
                        <li>Usage example</li>
                        {entry.hasTable && <li>Structured table</li>}
                        {entry.hasAvoid && <li>Avoid guidance</li>}
                        <li>Source prose</li>
                      </ul>
                    </div>

                    <details class="entry-details">
                      <summary>Full explanation</summary>
                      <div class="entry-body" set:html={entry.bodyHtml} />
                    </details>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </section>
    </main>
  </body>
</html>
